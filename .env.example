# Every key the app reads, with dummy values. Real values never go in the repository.
# Secrets
SLACK_APP_TOKEN='xapp-dummy-app-token'
# The home workspace's bot token; required unless the three distribution keys below are set
SLACK_BOT_TOKEN='xoxb-dummy-bot-token'
# Distribution to other workspaces: all three or none
SLACK_CLIENT_ID='0000000000.0000000000'
SLACK_CLIENT_SECRET='dummy-client-secret'
# At least 32 random characters; keys the OAuth state, the stored installations and strip URLs
APP_SECRET='dummy-app-secret-at-least-32-characters'
# Not secret
LOG_LEVEL='info'
# Public HTTPS origin that serves the die images; leave empty for text-only rolls
PUBLIC_BASE_URL='https://example.com'
# Where preferences.json and installations.json are kept; the default is ./data (/app/data in the container)
DATA_DIR='data'
# Set by the container image to 8080; only change it for local development
PORT='8080'
